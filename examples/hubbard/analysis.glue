# Analysis of the Hubbard-like sweep. Run from this folder with:
#   glue run --trust analysis.glue
# (--trust allows the project's Python plugin in ops/physops.py to load.)

load project.toml
info dmft

# --- 1. Look at raw data --------------------------------------------------

plot dmft.E by J where U=2.0, n=1.0 with logx > figs/01_dmft_energy.png

# DMFT and ED on the same axes. Line style marks the method, color marks U.
plot dmft=dmft.E, ed=ed.E by U where J=0.1, n=1.0 > figs/02_dmft_vs_ed.png

# --- 2. Differences on a common grid ---------------------------------------

# dE is a view: dmft.E - ed.E. The two methods use different T points,
# so both curves are interpolated onto a shared grid first.
explain plot dE by U where J=0.1, n=1.0
plot dE by U where J=0.1, n=1.0 > figs/03_dmft_minus_ed.png

# One ED file (U=2.0, J=0.1, n=0.9) has a repeated T row from a restarted job.
# The default duplicates=error stops on it. Averaging the two rows is right here.
set duplicates mean

# The difference in units of the gap, on a finer grid for this statement only.
# gap has one value per (U, J, n), so it acts as a constant along each curve.
# (Dividing by E itself would blow up where E crosses zero.)
rel = (dmft.E - ed.E) / gap.gap with grid=overlap(n=400)
plot rel by U where J=0.1, n=0.9 > figs/04_difference_over_gap.png

# --- 3. Calculus on curves -------------------------------------------------

# C is a view: d(dmft.E, T), the specific heat.
plot C by J where U=2.0, n=1.0 with logx > figs/05_specific_heat.png

# Peak position of C, one number per (U, J, n).
Tpeak = argmax(C)
plot Tpeak vs U by J where n=1.0 > figs/06_peak_position.png

# The two-level model predicts Tpeak close to 0.42 times the gap.
# gap is a keyed table: one value per run, broadcast onto every curve key.
ratio = Tpeak / gap.gap
plot ratio vs U by J where n=1.0 with ylim=(0.3, 0.5) > figs/07_peak_over_gap.png

# A custom reduce operation from ops/physops.py: width of the peak.
width = fwhm(C)
plot width vs U by n where J=0.1 > figs/08_peak_width.png

# Entropy from the specific heat: S(T) = integral of C/T dT.
S = int(C / T, T)
plot S by U where J=0.1, n=1.0 > figs/09_entropy.png

# --- 4. Noisy QMC data from SQLite -----------------------------------------

plot qmc=qmc.E, dmft=dmft.E where U=4.0, J=0.1, n=1.0, T=:0.55 with errorbars > figs/10_qmc_vs_dmft.png

# Evaluate DMFT at the QMC temperatures, so only DMFT is interpolated.
dQ = qmc.E - dmft.E with grid=like(qmc.E)
plot dQ by U where J=0.1, n=1.0 with style=linespoints > figs/11_qmc_minus_dmft.png

# --- 5. Change variables ---------------------------------------------------

# Scaling collapse. Measure T in units of the gap, then C should fall on one
# curve for every U. transform renames and rescales an input. The formula may
# use other fields. gap has one value per curve, so each curve gets its own scale.
Cs = transform(C, T, t = T / gap.gap)
plot Cs by U where J=0.1, n=1.0 > figs/13_scaling_collapse.png

# The average over fillings. mean() needs the curves on one grid first.
En = mean(resample(dmft.E, grid=linspace(0.05, 1.0, 100)), n)
plot En by U where J=0.1 > figs/14_mean_over_n.png

# Swap an input and an output. E rises with T, so T(E) is a function too.
# Below T=0.1 the curves are flat to within noise, and swap stops there with an
# error, so keep only the part where E clearly rises.
TE = swap(dmft.E[T=0.1:], T)
plot TE by U where J=0.1, n=1.0 > figs/15_T_of_E.png

# --- 6. Save results as datasets -------------------------------------------

save dE as results/dE_fine grid=overlap(n=400)
save Tpeak
save ratio
C_log = resample(C, grid=logspace(0.01, 1.0, 300))
save C_log
status

# Why a dataset is fresh or stale, and what it reads.
why Tpeak

# Saved datasets are tables too. Tpeak is now read from its cache file.
plot Tpeak vs J by U where n=0.9 > figs/12_saved_peak_vs_J.png

# Plain data for other tools. .dat files have one block per curve for gnuplot.
export dE_fine to exports/dE_fine.csv where J=0.1
export C_log to exports/C_log.dat where U=2.0, n=1.0
